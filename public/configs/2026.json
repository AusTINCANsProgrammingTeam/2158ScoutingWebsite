{
    "$schema": "./schema.json",
    "title": "QRScout",
    "page_title": "REBUILT",
    "sections": [
        {
            "name": "Autonomous",
            "fields": [
                {
                    "code": "AutoFuelScore",
                    "title": "Fuel Scored",
                    "type": "spinbox",
                    "defaultValue": 0,
                    "min": 0,
                    "required": false
                },
                {
                    "code": "AutoClimb",
                    "title": "Did the robot climb during auto?",
                    "type": "checkbox",
                    "defaultValue": false,
                    "required": false
                },
                {
                    "code": "AutoLeaveStarting",
                    "title": "Left Starting Line",
                    "type": "checkbox",
                    "defaultValue": false,
                    "required": false
                }
            ]
        },
        {
            "name": "Teleop",
            "fields": [
                {
                    "code": "TeleFuelScore",
                    "title": "Fuel Scored during ActiveHub",
                    "type": "spinbox",
                    "defaultValue": 0,
                    "min": 0,
                    "required": false
                },
                {
                    "code": "CrossRamp",
                    "title": "Did the robot drive over the ramp?",
                    "type": "checkbox",
                    "defaultValue": false,
                    "required": false
                },
                {
                    "code": "CrossTrench",
                    "title": "Did the robot drive under the trench?",
                    "type": "checkbox",
                    "defaultValue": false,
                    "required": false
                }
            ]
        },
        {
            "name": "Endgame",
            "fields": [
                {
                    "title": "Tower Level",
                    "type": "select",
                    "required": true,
                    "code": "TowerLevel",
                    "choices": {
                        "None": "No Climb",
                        "L1": "Level 1 (Bumper Must be Above Ground)",
                        "L2": "Level 2 (Bumper Must be Over)",
                        "L3": "Level 3 (Bumper Must be Over)"
                    },
                    "defaultValue": "None"
                },
                {
                    "title": "Fuel Pickup Locations",
                    "type": "select",
                    "required": true,
                    "code": "FuelPickup",
                    "choices": {
                        "N": "None",
                        "D": "Ground Only",
                        "C": "Chute Only",
                        "B": "Both"
                    },
                    "defaultValue": "None"
                }
            ]
        },
        {
            "name": "Postmatch",
            "fields": [
                {
                    "code": "majorFoul",
                    "title": "Major Fouls",
                    "type": "spinbox",
                    "defaultValue": 0,
                    "required": false
                },
                {
                    "code": "minorFoul",
                    "title": "Minor Fouls",
                    "type": "spinbox",
                    "defaultValue": 0,
                    "required": false
                },
                {
                    "code": "Died",
                    "title": "Died/Disabled",
                    "type": "checkbox",
                    "defaultValue": false,
                    "required": false
                },
                {
                    "code": "Tipped",
                    "title": "Tipped Over",
                    "type": "checkbox",
                    "defaultValue": false,
                    "required": false
                },
                {
                    "code": "YRCard",
                    "title": "Yellow/Red Card",
                    "type": "checkbox",
                    "defaultValue": false,
                    "required": false
                },
                {
                    "title": "Offense Skill",
                    "type": "range",
                    "required": false,
                    "code": "offskillrate",
                    "defaultValue": 0,
                    "min": -3,
                    "max": 3,
                    "step": 1
                },
                {
                    "title": "Defense Skill",
                    "type": "range",
                    "required": false,
                    "code": "defskillrate",
                    "defaultValue": 0,
                    "min": -3,
                    "max": 3,
                    "step": 1
                },
                {
                    "code": "comments",
                    "title": "Comments",
                    "type": "text",
                    "min": 0,
                    "max": 50,
                    "required": false,
                    "defaultValue": ""
                }
            ]
        }
    ]
}