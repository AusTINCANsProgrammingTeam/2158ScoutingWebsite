{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/data",
        "destination": "/data.html"
      },
      {
        "source": "/submit-form",
        "function": "api"
      },
      {
        "source": "/get-data",
        "function": "api"
      },
      {
        "source": "/get-api-data",
        "function": "api"
      }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs18"
  }
}